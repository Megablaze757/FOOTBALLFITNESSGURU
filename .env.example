# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Rotate any credential that has ever been pasted into chat, a commit, or a log.

# --- Supabase ---
# Found in: Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side ONLY, never ship to client

# Direct Postgres connection (for running migrations locally).
# Reset this password in Dashboard > Project Settings > Database if it was ever exposed.
SUPABASE_DB_URL=postgresql://postgres:CHANGE_ME@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- AI providers ---
# One chain for the whole app: Groq first (fastest, and every one of these calls
# happens while somebody waits), OpenRouter after it (breadth, so a retired or
# rate-limited Groq model falls through to different hardware rather than
# failing). See supabase/functions/_shared/llm.ts.
#
# Either alone is a working configuration — a provider with no key is skipped.
# Set both if you want the fallback.
AI_WORKER_URL=https://ai-worker.yourdomain.com
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional, comma-separated, to override the built-in model lists without a
# redeploy — which is how you fix a retired model slug in a hurry.
#   GROQ_TEXT_MODELS, GROQ_VISION_MODELS
#   OPENROUTER_TEXT_MODELS, OPENROUTER_VISION_MODELS
#
# VISION IS THE SHORT LIST AND THE ONE THAT BITES: most models cannot see, and
# the meal photo estimator was broken for exactly that reason — production ran a
# text-only chain and every photo went to something incapable of looking at it.
# Only put a model here after checking it accepts image input.

# Shared secret for the process-video Database Webhook. The function runs with
# the SERVICE ROLE, so anything that can call it bypasses RLS; set this and add
# the same value as an `x-webhook-secret` header on the webhook in the Supabase
# dashboard. The function also re-reads the video row from the database rather
# than trusting the payload, so this is the second layer, not the only one.
WEBHOOK_SECRET=

# --- Stripe (Phase 4) ---
# Set these as secrets on the Edge Functions: `supabase secrets set ...`
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=          # signing secret of the Stripe webhook endpoint
STRIPE_PRICE_SILVER=price_xxx   # Stripe recurring price ID for the Silver plan
STRIPE_PRICE_GOLD=price_xxx     # Stripe recurring price ID for the Gold plan
APP_URL=http://localhost:3000   # used for Stripe Checkout success/cancel redirects
