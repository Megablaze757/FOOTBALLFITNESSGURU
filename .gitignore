# Secrets — NEVER commit these
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key

# Dependencies
node_modules/
.pnp/
.venv/
__pycache__/
*.pyc

# Build output
.next/
dist/
build/
out/

# Supabase
supabase/.branches/
supabase/.temp/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local editor/tooling
.claude/

# TypeScript incremental build cache — rewritten by every build.
*.tsbuildinfo

# Scratch files from diagnostic scripts. Never part of the app.
_*.mjs
_*.ts
_*.svg
_*.js

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Drafted exercise cues awaiting review — regenerate rather than commit.
scripts/out/

# Theme screenshots — regenerate with `npm run shots`, do not commit.
screenshots/
