# Copy to `.env` (gitignored). The service runs with NO provider key at all,
# using a deterministic fallback narrative — set one to enable the LLM coach.
#
# Groq first, OpenRouter behind it. Either alone works; a provider with no key
# is skipped rather than attempted. Same chain as the rest of the app — see
# supabase/functions/_shared/llm.ts.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional, comma-separated, to override the built-in model lists.
# GROQ_TEXT_MODELS=
# OPENROUTER_TEXT_MODELS=

# Shared secret the Edge Function sends as the `x-worker-key` header.
WORKER_API_KEY=
PORT=8000
